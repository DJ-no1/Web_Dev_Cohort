    },
    {
      "id": "oA_FLzIwr5cuoi_-EEFYl",
      "type": "text",
      "x": 34429.71952713959,
      "y": 17193.310101032992,
      "width": 340.4566345214844,
      "height": 15.6,
      "angle": 0,
      "strokeColor": "#a0a0a0",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bg1",
      "roundness": null,
      "seed": 702245037,
      "version": 89,
      "versionNonce": 862344407,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773990117895,
      "link": null,
      "locked": false,
      "text": "Without it:  V8 objects cannot talk to C++ functions.",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Without it:  V8 objects cannot talk to C++ functions.",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
      "id": "t_1FEKyy5Sva-tEGGoPZq",
      "type": "text",
      "x": 34429.71952713959,
      "y": 17213.310101032992,
      "width": 294.8006591796875,
      "height": 15.6,
      "angle": 0,
      "strokeColor": "#a0a0a0",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bg2",
      "roundness": null,
      "seed": 86231821,
      "version": 89,
      "versionNonce": 1551321113,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773990117895,
      "link": null,
      "locked": false,
      "text": "C++ results cannot be read back in JavaScript.",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C++ results cannot be read back in JavaScript.",
      "autoResize": true,
      "lineHeight": 1.2
    },
