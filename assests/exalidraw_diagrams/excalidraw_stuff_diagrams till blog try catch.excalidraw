      "updated": 1773990117895,
      "link": null,
      "locked": false,
      "text": "Cross-platform async I/O library written in C  —  whenever JS touches the real world, libuv is involved",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cross-platform async I/O library written in C  —  whenever JS touches the real world, libuv is involved",
