      "text": "Event Loop  +  Thread Pool  =  non-blocking Node.js",
      "fontSize": 20.167569932975752,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Event Loop  +  Thread Pool  =  non-blocking Node.js",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
      "id": "rwvzZPSHq_dGI8yFvfAeh",
      "type": "text",
      "x": 34973.7710712364,
      "y": 21569.44555225861,
      "width": 861.5576782226562,
      "height": 17.478560608578984,
      "angle": 0,
      "strokeColor": "#a0a0a0",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bnM",
      "roundness": null,
      "seed": 812382633,
      "version": 256,
      "versionNonce": 520760503,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773990117896,
      "link": null,
      "locked": false,
      "text": "Event Loop handles async JS callbacks.  Thread Pool handles blocking C work.  Together they keep the main thread free.",
      "fontSize": 14.565467173815822,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Event Loop handles async JS callbacks.  Thread Pool handles blocking C work.  Together they keep the main thread free.",
      "autoResize": true,
      "lineHeight": 1.2
    },
