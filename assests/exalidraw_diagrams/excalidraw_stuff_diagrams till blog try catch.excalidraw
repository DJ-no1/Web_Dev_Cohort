      "isDeleted": false,
      "boundElements": [],
      "updated": 1773990117895,
      "link": null,
      "locked": false,
      "text": "It is also a type translator.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It is also a type translator.",
      "autoResize": true,
