      "updated": 1773990117897,
      "link": null,
      "locked": false,
      "text": "What is OOP?",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What is OOP?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cypmPizK7RmCHKjJ6zkmI",
      "type": "text",
      "x": 37079.080115290475,
      "y": 13883.406030282003,
      "width": 781.455322265625,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c06O",
      "roundness": null,
      "seed": 1401328838,
      "version": 9,
      "versionNonce": 2018871961,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773990117897,
      "link": null,
      "locked": false,
      "text": "OOP (Object-Oriented Programming) is a programming approach where we organize code into objects.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "OOP (Object-Oriented Programming) is a programming approach where we organize code into objects.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "HnqLC76fsx9-uTu8NCVya",
      "type": "text",
      "x": 37079.080115290475,
      "y": 13908.406030282003,
      "width": 763.9032592773438,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c06P",
      "roundness": null,
      "seed": 950275078,
      "version": 9,
      "versionNonce": 160483191,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773990117897,
      "link": null,
      "locked": false,
      "text": "A Class is a blueprint — it defines the structure.   An Object is an instance — it holds real data.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A Class is a blueprint — it defines the structure.   An Object is an instance — it holds real data.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XOVKOxn6YD7FZ6nX-YBFn",
      "type": "text",
      "x": 37079.080115290475,
      "y": 13933.406030282003,
      "width": 834.5112915039062,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c06Q",
      "roundness": null,
      "seed": 1636866886,
      "version": 9,
      "versionNonce": 710594425,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773990117897,
      "link": null,
      "locked": false,
      "text": "Instead of scattered variables and functions, related data and actions are grouped together in one place.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Instead of scattered variables and functions, related data and actions are grouped together in one place.",
      "autoResize": true,
      "lineHeight": 1.25
    },
