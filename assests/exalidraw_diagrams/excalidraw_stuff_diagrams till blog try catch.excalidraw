      "text": "Destructuring is not just syntax sugar — it is a mindset shift:",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Destructuring is not just syntax sugar — it is a mindset shift:",
